{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write src tests tools",
    "size": "find src -path src/legacy -prune -o -path src/prototype -prune -o \\( -name '*.ts' -o -name '*.tsx' \\) ! -name '*.test.*' -print | xargs cat | wc -l",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.13",
    "@better-auth/sso": "^1.7.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.105.0",
    "@use-gesture/react": "^10.3.1",
    "@vimeo/player": "^2.30.4",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "immer": "^11.2.9",
    "jspdf": "^4.2.1",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
