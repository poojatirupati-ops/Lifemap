{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lifemap-pwa",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "_site"
      ],
      "port": 8080
    },
    {
      "name": "lifemap-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    }
  ]
}