{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lifemap-pwa",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "_site"
      ],
      "port": 8080
    },
    {
      "name": "lifemap-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "lifemap-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=postgres://lifemap:lifemap-dev@localhost:5432/lifemap GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-} GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-} FEATURE_OVERRIDES=documentUpload=true,adviserBooking=true npm --prefix api run dev 2>&1 | tee /tmp/lifemap-api.log"
      ],
      "port": 8787
    },
    {
      "name": "lifemap-cms",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm --prefix cms run dev 2>&1 | tee /tmp/lifemap-cms.log"
      ],
      "port": 3000
    }
  ]
}
