# Dev: Postgres 17 from ../compose.yaml (`podman compose up -d` in the repo root), database `cms`.
DATABASE_URL=postgres://lifemap:lifemap-dev@localhost:5432/cms
PAYLOAD_SECRET=dev-only-change-me
# The app's origins allowed to read the REST API (comma list).
CMS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Staff login the seed creates (dev only).
SEED_STAFF_EMAIL=staff@lifemap.test
SEED_STAFF_PASSWORD=lifemap-staff-dev
# Vimeo upload (docs/cms.md). Empty: the video upload field says Vimeo is not configured.
VIMEO_ACCESS_TOKEN=
