    "@hono/node-server": "^2.1.5",
    "@scalar/hono-api-reference": "^0.12.17",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "hono-openapi": "^1.5.0",
    "pg": "^8.23.1",
    "posthog-node": "^5.21.2",
