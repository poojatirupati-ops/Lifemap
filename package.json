{
  "name": "lifemap",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "app",
    "api",
    "cms",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "sst": "4.17.2"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "core-js": false,
    "fsevents@2.3.3": true
  }
}
